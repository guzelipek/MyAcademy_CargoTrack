@model List<RoleAssignDto>
@{
    ViewData["Title"] = "Assign Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3>Rol Ata</h3>
<h4><strong>@ViewBag.fullName kullanıcısına rol atama işlemlerini aşağıdan gerçekleştirebilirsiniz.</strong></h4>
<form method="post">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="form-check">
            <input type="checkbox" asp-for="@Model[i].RoleExist" class="form-check-input" />
            <label class="form-check-label">@Model[i].RoleName</label>
            <input type="hidden" asp-for="@Model[i].RoleId" />
            <input type="hidden" asp-for="@Model[i].UserId" />
            <input type="hidden" asp-for="@Model[i].RoleName" />
        </div>
    }
    <button class="btn btn-dark mt-3">Rolleri Ata</button>
</form>
